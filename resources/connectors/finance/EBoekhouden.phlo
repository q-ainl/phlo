@ version:  1.0
@ creator:  q-ai.nl
@ summary:  e-Boekhouden.nl connector: session auth from an API token, relations and sales invoices
@ advice:   Authenticates with a session rather than a token per call: the first call trades api_token for one, later calls in the same request reuse it, and a new request starts over. Sessions are limited, so gather the work you need per request instead of making a connector per call.
@ extends:  Connector
@ package:  connectors
@ frontend: false
@ backend:  true
@ requires: @Connector creds:EBoekhouden
@ tags:     eboekhouden accounting invoices relations connector

const section = 'EBoekhouden'
const api = 'https://api.e-boekhouden.nl/v1'

prop sessionToken:string = void

method headers:array => $this->sessionToken !== void ? ['Authorization: '.$this->sessionToken] : []

static fields:array => arr(
	section: 'EBoekhouden',
	config: arr(source: 'Source label shown in the e-Boekhouden audit trail (optional)'),
	secret: arr(api_token: 'API token (Beheer > Instellingen > API)'),
)

// Returns the session token, fetching one on first use.
// The API takes a session rather than a token per call, so the first call exchanges the
// API token for one and every later call in the same request reuses it.
method session():obj {
	if ($m = $this->missing('api_token')) return $m
	if ($this->sessionToken !== void) return static::ok($this->sessionToken)
	$res = $this->post('session', ['accessToken' => trim((string)$this->config['api_token']), 'source' => (string)($this->config['source'] ?? 'Phlo')])
	if (!$res->ok) return $res
	$token = (string)($res->data->token ?? void)
	if ($token === void) return static::fail('e-Boekhouden session token missing in response', $res->status)
	$this->sessionToken = $token
	return static::ok($token)
}

method guard():?obj {
	$res = $this->session
	return $res->ok ? null : $res
}

method relations(array $query = []):obj {
	if ($m = $this->guard) return $m
	return $this->get('relation', $query)
}

method createRelation(array $relation):obj {
	if ($m = $this->guard) return $m
	return $this->post('relation', $relation)
}

method invoices(array $query = []):obj {
	if ($m = $this->guard) return $m
	return $this->get('invoice', $query)
}

method createInvoice(array $invoice):obj {
	if ($m = $this->guard) return $m
	return $this->post('invoice', $invoice)
}
