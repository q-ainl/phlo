@ version:  1.0
@ creator:  q-ai.nl
@ summary:  Multilingual SEO: sitemap.xml, robots.txt, hreflang + head meta (description/OG/Twitter/canonical)
@ advice:   Serves sitemap.xml and robots.txt itself and writes the head meta, so a page needs no SEO markup of its own. It reads from the app: pages for the sitemap, slugs for translated URLs, description, image and structuredData for the head, so filling those is the whole job. Every language of a page points at the others with hreflang, and a lastmod resource, when there is one, dates the sitemap.
@ package:  seo
@ frontend: false
@ backend:  true
@ requires: output
@ tags:     seo sitemap robots hreflang opengraph multilingual

route GET sitemap.xml => output($this)

route GET robots.txt => output($this->robots(), type: 'text/plain; charset=utf-8')

method robots:string {
	if (!(defined('indexable') && indexable)) return 'User-agent: *'.lf.'Disallow: /'.lf
	$lines = ['User-agent: *', 'Allow: /']
	foreach ((array)(%app->robotsDisallow ?? []) AS $path) $lines[] = 'Disallow: '.$path
	$lines[] = 'Sitemap: '.%req->base.slash.'sitemap.xml'
	return implode(lf, $lines).lf
}

method intl($uri):string => (%app->slugs ?? [])[$uri] ?? $uri

// A sitemap entry is a uri string, or an object carrying that uri plus more.
// Keeping it a list rather than a uri => value map leaves room for a second
// fact later without changing what an entry means.
method uri($page):string => is_string($page) ? $page : (string)($this->field($page, 'uri') ?? void)

method field($page, $key):mixed {
	if (is_string($page)) return null
	return is_array($page) ? ($page[$key] ?? null) : ($page->$key ?? null)
}

// The date for one entry, or nothing at all when it does not parse.
// A wrong lastmod is worse than none: a crawler that catches a site inventing
// them stops trusting the field domain-wide. An entry without a date of its own
// falls back to the lastmod resource, so an app that loads it needs no change
// here for its pages to carry one.
method lastmod($page):?string {
	$mod = $this->field($page, 'lastmod')
	($mod === null || $mod === void) && class_exists('lastmod') && $mod = %lastmod->for($this->uri($page))
	if ($mod === null || $mod === void) return null
	if (is_string($mod) && preg_match('/^\d{4}-\d{2}-\d{2}$/', $mod)) return $mod
	$ts = is_int($mod) ? $mod : strtotime((string)$mod)
	return $ts ? date('c', $ts) : null
}

method locale:string {
	$lang = %app->lang ?? 'en'
	$map = ['nl' => 'nl_NL', 'en' => 'en_US', 'de' => 'de_DE', 'fr' => 'fr_FR', 'es' => 'es_ES', 'it' => 'it_IT', 'pt' => 'pt_PT', 'pl' => 'pl_PL', 'ru' => 'ru_RU', 'el' => 'el_GR', 'tr' => 'tr_TR', 'zh' => 'zh_CN']
	return $map[$lang] ?? $lang
}

prop ogTitle:string => title()
prop ogDescr => %app->description ?? void
prop ogImageFile:string => (string)(%app->image ?? (is_file(www.'icon.webp') ? 'icon.webp' : void))
prop ogImage:string => $this->ogImageFile === void ? void : %req->base.slash.ltrim($this->ogImageFile, slash)
prop canonical:string => %req->url
prop ogType:string = 'website'
prop sitemapPages:array => (array)(%app->pages ?? [''])
prop sitemapLangs:array => array_keys((array)(%app->langs ?? []))
prop siteName:string => %app->title ?? id
prop twitterCard:bool = false
// Schema.org data for this page, as '@type' plus what only your app knows.
// The url, language, publisher, description and image are filled in from what
// this resource already resolves for the og tags, so a page cannot describe
// itself two different ways.
prop structuredData => %app->structuredData ?? null

method schemaData:?array {
	if (!$this->structuredData) return null
	$base = [
		'@context' => 'https://schema.org',
		'url' => $this->canonical,
		'inLanguage' => %app->lang ?? 'en',
		'mainEntityOfPage' => ['@type' => 'WebPage', '@id' => $this->canonical],
		'publisher' => ['@type' => 'Organization', 'name' => $this->siteName, 'url' => %req->base],
	]
	$this->ogDescr && $base['description'] = $this->ogDescr
	$this->ogImage && $base['image'] = $this->ogImage
	return array_replace($base, (array)$this->structuredData)
}
prop noIndex:bool => %app->noLink ?? %app->noIndex ?? false

view:
<?xml version=1.0 encoding="UTF-8"?>
<urlset xmlns=http://www.sitemaps.org/schemas/sitemap/0.9 xmlns:xhtml=http://www.w3.org/1999/xhtml xmlns:xsi=http://www.w3.org/2001/XMLSchema-instance xsi:schemaLocation=http://www.sitemaps.org/schemas/sitemap/0.9+http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd>
	<foreach $this->sitemapPages AS $page>
		{{ $this->page($page) }}
	</foreach>
</urlset>

view page($page):
<url>
	<loc>%req->base{( ($uri = $this->uri($page)) ?: slash )}</loc>
	<if $stamp = $this->lastmod($page)>
		<lastmod>$stamp</lastmod>
	</if>
	<foreach $this->sitemapLangs AS $lang>
		<if $lang === %app->lang>
			{{ $this->xlink('x-default', $uri ?: slash) }}
		</if>
		{{ $this->xlink($lang, $lang === %app->lang ? ($uri ?: slash) : "/$lang".($this->intl($uri) ?: void)) }}
	</foreach>
</url>

view xlink($lang, $uri): <xhtml:link rel=alternate hreflang="$lang" href="%req->base$uri"{{ slash }}>
view link($lang, $uri): <link rel=alternate hreflang="$lang" href="%req->base$uri">

view head:
<if $this->noIndex>
	<meta name=robots content=noindex,follow>
</if>
<if $this->ogDescr>
	<meta name=description content="$this->ogDescr">
</if>
<meta property=og:site_name content="$this->siteName">
<meta property=og:title content="{[ $this->ogTitle ]}">
<meta property=og:description content="$this->ogDescr">
<meta property=og:type content="$this->ogType">
<meta property=og:url content="{[ $this->canonical ]}">
<if $this->ogImage>
	<meta property=og:image content="$this->ogImage">
</if>
<meta property=og:locale content="$this->locale">
<if $this->twitterCard>
	<meta name=twitter:card content=summary_large_image>
	<meta name=twitter:title content="{[ $this->ogTitle ]}">
	<meta name=twitter:description content="$this->ogDescr">
	<if $this->ogImage>
		<meta name=twitter:image content="$this->ogImage">
	</if>
</if>
<if $data = $this->schemaData>
	<script type="application/ld+json">{{ json_encode($data, JSON_UNESCAPED_UNICODE) }}</script>
</if>
<if !$this->noIndex>
	<link rel=canonical href="{[ $this->canonical ]}">
</if>
