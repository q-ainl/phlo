@ version:  1.0
@ creator:  q-ai.nl
@ summary:  File resource
@ advice:   Wrap a path in %file and everything about it is one call away: contents, size, mime, hashes, human dates, and a token() derived from the file's sha1, so the same content always yields the same token. Watch the difference between file and name: file is where it sits, name is what it is called, and ext and mime read the name. An upload therefore keeps its extension while the temp path has none.
@ package:  files
@ frontend: false
@ backend:  true
@ tags:     file filesystem io

static __handle => "file/$file".($name ? "/$name" : void)
method __construct(public string $file, ?string $name = null, $contents = null, ...$args){
	$name && $this->name = $name
	is_string($contents) && $this->write($contents)
	$args && $this->objImport(...$args)
}

method append(string $data):int|false => file_put_contents($this->file, $data, FILE_APPEND | LOCK_EX)
prop basename:string => pathinfo($this->file, PATHINFO_BASENAME)
method base64:string => base64_encode($this->contents)
method contents:string|false => file_get_contents($this->file)
method contentsINI(bool $parse = true):array|false => parse_ini_string($this->contents, true, $parse ? INI_SCANNER_TYPED : INI_SCANNER_RAW)
method contentsJSON($assoc = null) => json_decode($this->contents, $assoc)
method copy($to):bool => copy($this->file, $to)
method created:int|false => filectime($this->file)
method createdAge:int => age($this->created)
method createdHuman:string => time_human($this->created)
method curl($type = null, $filename = null):CURLFile => new CURLFile($this->file, $type, $filename)
method delete:bool => first($deleted = $this->exists && unlink($this->file), debug($deleted ? "Deleted $this->basename" : "Could not delete $this->basename"))
method exists:bool => file_exists($this->file)
prop ext:string => pathinfo($this->name, PATHINFO_EXTENSION)
prop filename:string => pathinfo($this->file, PATHINFO_FILENAME)
method getLine:string|false => ($line = fgets($this->pointer)) === false ? false : rtrim($line)
method getLength(int $length):string|false => fread($this->pointer, $length)
method is(string $file):bool => $file === $this->file
method md5:string|false => md5_file($this->file)
prop mime:string => mime($this->name)
method modified:int|false => filemtime($this->file)
method modifiedAge:int => age($this->modified)
method modifiedHuman:string => time_human($this->modified)
method move($to):bool => rename($this->file, $to) && $this->file = $to
prop name:string => $this->basename
method output($download = false) => output($this->contents, $this->name, $download)
prop path:string => realpath(pathinfo($this->file, PATHINFO_DIRNAME)).slash
prop pathRel:string => str_starts_with($this->file, app) ? substr($this->file, strlen(app)) : $this->file
prop pointer => fopen($this->file, 'r+')
method readable:bool => is_readable($this->file)
method src:string => "data:$this->mime;base64,$this->base64"
method size:int|false => filesize($this->file)
method sizeHuman(int $precision = 0):string => size_human($this->size, $precision)
method sha1:string|false => sha1_file($this->file)
method shortenTo(int $length):string => strlen($this->name) <= $length ? $this->name : substr($this->name, 0, $length - strlen($this->ext) - 3).dot.dot.dot.$this->ext
method title:string => ucfirst(strtr(pathinfo($this->name, PATHINFO_FILENAME), [us => space]))
method token($length = 20):string => token($length, $this->sha1)
method type:string => substr($this->mime, 0, strpos($this->mime, slash))
method touch:bool => touch($this->file)
method writable:bool => is_writable($this->file)
method writeINI($data, bool $deleteEmpty = false):bool => $this->write(!$deleteEmpty || $data ? loop($data, fn($value, $key) => $key.' = '.dq.strtr($value, [dq => bs.dq, lf => '\n']).dq, lf).lf : void, $deleteEmpty)
method writeJSON($data, bool $deleteEmpty = false):bool => $this->write(!$deleteEmpty || $data ? json_encode($data, jsonPretty) : void, $deleteEmpty)
method writeJSONplain($data, bool $deleteEmpty = false):bool => $this->write(!$deleteEmpty || $data ? json_encode($data) : void, $deleteEmpty)
method write(string $data, bool $deleteEmpty = false):bool {
	if (!$data && $deleteEmpty) return $this->delete
	if ($written = file_put_contents($this->file, $data, LOCK_EX) !== false) debug('Written '.$this->basename.' ('.$this->sizeHuman.')')
	else error('Could not write '.$this->file)
	return $written
}

method objInfo:array => array_combine($keys = array_merge(['file', 'name', 'exists'], $this->exists ? ['sizeHuman', 'createdHuman', 'modifiedHuman', 'mime'] : []), loop($keys, fn($arg) => $this->$arg))
