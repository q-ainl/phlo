@ extends:  field
@ class:    field_select
@ version:  1.0
@ creator:  q-ai.nl
@ summary:  Select field
@ advice:   Stores the chosen option itself rather than a key, so renaming an option later leaves older records pointing at wording you no longer offer. Pass the accepted values as options.
@ package:  fields
@ frontend: false
@ backend:  true
@ tags:     field select

method input($record) => select(name: $this->name, inner: loop($this->options, fn($option) => "<option".($record->{$this->name} === $option ? ' selected' : void).">$option", void))

prop objColumns => [$this->name]
