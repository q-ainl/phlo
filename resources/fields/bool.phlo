@ extends:     field
@ class:       field_bool
@ version:  1.0
@ creator:     q-ai.nl
@ summary:     Boolean field
@ advice:      Stores 1 or 0 and never null, so a checkbox that is left alone still saves a value. Set true and false to change the two symbols a list shows.
@ package:     fields
@ frontend:    true
@ backend:     true
@ tags:        field boolean input

prop true = '✅'
prop false = '❌'

method label($record):string => $record->{$this->name} ? $this->true : $this->false
method input($record):string => tag('label', inner: input(type: 'checkbox', name: $this->name, value: 1, checked: $record->{$this->name} ? true : null).tag('span', class: 'slider', inner: void))
method parse($record):int => $record->{$this->name} = %payload->{$this->name} ? 1 : 0
method nullable:bool => false

prop objColumns:array => [$this->name]
