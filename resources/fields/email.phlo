@ extends:  field
@ class:    field_email
@ version:  1.0
@ creator:  q-ai.nl
@ summary:  Email field
@ advice:   Only changes how a stored address is shown, as a mailto link. It validates nothing, so add pattern or required when the address has to be real.
@ package:  fields
@ frontend: false
@ backend:  true
@ tags:     field email
@ extends:  field_text

view label($record): <a href="mailto:{{ $record->{$this->name} }}">{{ $record->{$this->name} }}</a>
