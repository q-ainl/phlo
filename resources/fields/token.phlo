@ extends:  field
@ class:    field_token
@ version:  1.0
@ creator:  q-ai.nl
@ summary:  Token field
@ advice:   Fills itself with a random token when a record is made and refuses to change afterwards, which makes it the id to use for anything that ends up in a URL. It handles, so a record can be looked up by it.
@ package:  fields
@ frontend: false
@ backend:  true
@ tags:     field token

prop length = 8
prop default:string => token($this->length)
prop create = false
prop change = false
prop search = true
prop handle = true

method label($record):string => tag('div', inner: esc($record->{$this->name}))
method parse($record) => $record->{$this->name} ??= $this->default

prop objColumns:array => [$this->name]
