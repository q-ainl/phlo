@ summary: Field-type test probe. Instantiates fields directly (no database) and exercises the
@          shared validation rules (required/length/pattern/enum) and the per-type rendering of
@          a value, so each field type is covered without a model or storage.

static validation => [
	'reqEmpty' => field(type: 'text', name: 'name', required: true)->objValidate(null),
	'reqOk' => field(type: 'text', name: 'name', required: true)->objValidate('Ann'),
	'tooLong' => field(type: 'text', name: 'name', length: 3)->objValidate('abcde'),
	'lenOk' => field(type: 'text', name: 'name', length: 5)->objValidate('abc'),
	'patBad' => field(type: 'text', name: 'slug', pattern: '^[a-z]+$')->objValidate('Nope!'),
	'patOk' => field(type: 'text', name: 'slug', pattern: '^[a-z]+$')->objValidate('ok'),
	'enumBad' => field(type: 'select', name: 'status', enum: ['draft', 'live'])->objValidate('boom'),
	'enumOk' => field(type: 'select', name: 'status', enum: ['draft', 'live'])->objValidate('live'),
	'optionalNull' => field(type: 'text', name: 'bio')->objValidate(null),
]

static rendering => [
	'boolOn' => field(type: 'bool', name: 'active')->label(new obj(active: 1)),
	'boolOff' => field(type: 'bool', name: 'active')->label(new obj(active: 0)),
	'boolInput' => field(type: 'bool', name: 'active')->input(new obj(active: 1)),
	'selectInput' => field(type: 'select', name: 'status', options: ['draft', 'live'])->input(new obj(status: 'live')),
	'emailLabel' => field(type: 'email', name: 'email')->label(new obj(email: 'a@b.com')),
	'numberInput' => field(type: 'number', name: 'qty')->input(new obj(qty: 5)),
	'numberLabel' => field(type: 'number', name: 'qty', decimals: 2)->label(new obj(qty: 1234.5)),
	'numberLabelZero' => field(type: 'number', name: 'qty')->label(new obj(qty: 0)),
	'numberLabelEmpty' => field(type: 'number', name: 'qty')->label(new obj(qty: null)),
	'priceLabelEmpty' => field(type: 'price', name: 'rate')->label(new obj(rate: null)),
	'passwordLabel' => field(type: 'password', name: 'pass')->label(new obj(pass: 'secret')),
	'dateLabel' => field(type: 'date', name: 'created')->label(new obj(created: '2025-09-01')),
]

static parsing {
	$record = new obj(pass: 'kept')
	field(type: 'password', name: 'pass')->parse($record)
	$out = ['absentLeavesRecord' => $record->pass]
	%payload->objImport(qty: void, rate: '4.50', spaces: '   ', kept: '9', fallback: void)
	$numbers = new obj(qty: 12, rate: 1, spaces: 5, kept: 1, fallback: 1, absent: 3)
	field(type: 'number', name: 'qty')->parse($numbers)
	field(type: 'price', name: 'rate')->parse($numbers)
	field(type: 'number', name: 'spaces')->parse($numbers)
	field(type: 'number', name: 'kept')->parse($numbers)
	field(type: 'number', name: 'fallback', default: 2)->parse($numbers)
	field(type: 'number', name: 'absent')->parse($numbers)
	$out['emptyBecomesZero'] = $numbers->qty
	$out['blankBecomesZero'] = $numbers->spaces
	$out['emptyTakesDefault'] = $numbers->fallback
	$out['priceKeepsValue'] = $numbers->rate
	$out['numberKeepsValue'] = $numbers->kept
	$out['absentIsUntouched'] = $numbers->absent
	return $out
}

// An upload stored before the extension was lowercased still sits on disk under its own case.
// Nothing migrates those, so read() has to look there when the lowercase name is not a file.
static storedBefore {
	$dir = sys_get_temp_dir().'/fieldprobe-old-'.getmypid().slash
	is_dir($dir) || mkdir($dir)
	defined('files') || define('files', $dir)
	$token = 'abcd1234'
	is_dir($dir.'ab') || mkdir($dir.'ab')
	file_put_contents($dir.'ab'.slash.'cd1234.JPG', 'x')
	$field = field(type: 'file', name: 'photo', path: $dir)
	$record = new obj(photo: 'FOTO.JPG', photo_token: $token)
	$out = ['readAs' => basename($field->read($record)->file)]
	unlink($dir.'ab'.slash.'cd1234.JPG')
	rmdir($dir.'ab')
	rmdir($dir)
	return $out
}

static storing {
	$dir = sys_get_temp_dir().'/fieldprobe-'.getmypid().slash
	is_dir($dir) || mkdir($dir)
	// The field's default path is the app's files constant, which an app defines and this fixture
	// does not; the probe hands its own path in, but the default is still read.
	defined('files') || define('files', $dir)
	$upload = %file(tempnam($dir, 'up'), name: 'FOTO.JPG')
	$field = field(type: 'file', name: 'photo', path: $dir)
	$written = $field->writePath($upload)
	$record = new obj(photo: 'FOTO.JPG', photo_token: $upload->token)
	$out = ['writtenAs' => basename($written), 'readAs' => basename($field->read($record)->file), 'label' => $field->label($record)]
	$upload->delete()
	rmdir(dirname($written))
	rmdir($dir)
	return $out
}
